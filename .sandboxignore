# Files and folders hidden from the agent. sandbox.ps1 mounts an empty read-only
# placeholder over every match in ./workspace and in mounted folders.
# One name pattern per line (wildcards * and ?), matched against file/folder names.
# Lines starting with ! un-hide a name. node_modules, venvs and __pycache__ are not scanned.
# Folders whose own name (or a parent's) matches are refused outright, e.g. mounting ~\.aws.

# Environment files
.env
*.env
.env.*
!.env.example
!.env.sample
!.env.template

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Credential stores
.ssh
.aws
.azure
.gcloud
.kube
.docker
.npmrc
.pypirc
.netrc
credentials.json
service-account*.json
